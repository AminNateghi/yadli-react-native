{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "arrowParens": "avoid",
  "jsxSingleQuote": true,
  "proseWrap": "always",
  "htmlWhitespaceSensitivity": "ignore",
  "bracketSpacing": true,
  "useTabs": false,
  "printWidth": 120,
  "singleAttributePerLine": true,
  "endOfLine": "auto"
}