{
  "expo": {
    "name": "Yadli",
    "slug": "yadli-app",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/yadli-icon.png",
    "scheme": "yadli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "180",
      "bundleIdentifier": "xyz.nateghi.yadli",
      "supportsTablet": true
    },
    "android": {
      "versionCode": 180,
      "package": "xyz.nateghi.yadli",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/yadli-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/yadli-icon-transparency.png",
          "dark": {
            "image": "./assets/images/yadli-icon-transparency.png",
            "backgroundColor": "#3a3a3a"
          },
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-notifications",
      "./plugins/with-android-release-signing",
      "expo-sharing",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}