{
  "expo": {
    "name": "Yadli",
    "slug": "yadli-app",
    "version": "1.0.29",
    "orientation": "portrait",
    "icon": "./assets/images/yadli-icon.png",
    "scheme": "yadli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "xyz.nateghi.yadli",
      "supportsTablet": true
    },
    "android": {
      "package": "xyz.nateghi.yadli",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/yadli-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/yadli-icon-light.png",
          "dark": {
            "image": "./assets/images/yadli-icon-dark.png",
            "backgroundColor": "#3a3a3a"
          },
          "imageWidth": 200
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}